{
  "name": "@alejandrocantero/agent-runner",
  "version": "0.1.0",
  "description": "Run coding agents inside sandboxed worktrees.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./sandboxes": {
      "types": "./dist/sandboxes/index.d.ts",
      "import": "./dist/sandboxes/index.js"
    }
  },
  "imports": {
    "#src/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx examples/basic.ts",
    "build": "tsc -p tsconfig.json",
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "release": "tsx scripts/release.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "keywords": [
    "agent",
    "sandbox",
    "worktree",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
